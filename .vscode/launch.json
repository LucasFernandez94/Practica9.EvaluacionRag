{
  "version": "0.2.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    }
  ],
  "configurations": [
    {
      "name": ".NET Launch (Practica9)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/Practica9.EvaluacionRag.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
